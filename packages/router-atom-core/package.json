    "build": "tsdown",
    "prepublishOnly": "cp ../../LICENSE LICENSE",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@tanstack/router-core": "^1.171.27",
    "effect": "4.0.5",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/router-core": ">=1.171.27",
    "effect": "^4.0.0"
  }
}
