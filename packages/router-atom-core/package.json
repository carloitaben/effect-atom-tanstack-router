{
  "name": "effect-atom-tanstack-router-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Effect Atom SSR integration for TanStack Router",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
