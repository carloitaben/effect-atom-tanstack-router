{
  "name": "effect-atom-tanstack-solid-router",
  "version": "0.2.0",
  "description": "TanStack Router SSR hydration integration for Effect Atom",
  "homepage": "https://github.com/carloitaben/effect-atom-tanstack-router#readme",
  "bugs": "https://github.com/carloitaben/effect-atom-tanstack-router/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloitaben/effect-atom-tanstack-router.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "cp ../../LICENSE LICENSE",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@effect/atom-solid": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@tanstack/router-core": "^1.171.27",
    "@tanstack/solid-router": "^1.170.30",
    "@types/react": "^19.0.8",
    "effect": "4.0.5",
    "solid-js": "^1.9.15",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@effect/atom-solid": "^4.0.0",
    "@tanstack/router-core": "^1.171.27",
    "@tanstack/solid-router": ">=1.170.30",
    "effect": "^4.0.0",
    "solid-js": ">=1.9.0 <2.0.0"
  }
}
