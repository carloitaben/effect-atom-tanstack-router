    "effect": "4.0.0-rc.112",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@effect/atom-react": ">=4.0.0-beta",
    "@tanstack/react-router": ">=1.127.0",
    "@tanstack/router-core": ">=1.171.27",
    "effect": ">=4.0.0-beta",
    "react": ">=19.0.0 <20.0.0"
  },
  "publishConfig": {
