{
  "name": "effect-atom-tanstack-devtools",
  "version": "0.1.0",
  "description": "TanStack Devtools integration for Effect Atom",
  "homepage": "https://github.com/carloitaben/effect-atom-tanstack-router#readme",
  "bugs": "https://github.com/carloitaben/effect-atom-tanstack-router/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloitaben/effect-atom-tanstack-router.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./solid": "./src/solid/index.tsx"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "./solid": {
        "solid": "./src/solid/index.tsx",
        "types": "./dist/solid.d.mts",
        "default": "./dist/solid.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "cp ../../LICENSE LICENSE",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/solid-devtools": "^0.8.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "babel-preset-solid": "^1.9.15",
    "effect": "4.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.15",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/react-devtools": ">=0.10.0",
    "@tanstack/solid-devtools": ">=0.8.0",
    "effect": "^4.0.0",
    "react": ">=19.0.0 <20.0.0",
    "solid-js": ">=1.9.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-devtools": {
      "optional": true
    },
    "@tanstack/solid-devtools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
